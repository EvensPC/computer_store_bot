# --- Режим webhook (для Render и других PaaS) ---
# На Render переменные RENDER_EXTERNAL_URL и PORT платформа задаёт сама,
# поэтому вручную их указывать не нужно. Для VPS оставьте пусто — включится polling.
# WEBHOOK_URL=https://your-service.onrender.com
# WEBHOOK_PATH=/telegram/webhook
# WEBHOOK_SECRET=любая_строка_из_букв_цифр_и_подчёркиваний
# PORT=8080
